{
  "realm": "multitenant-saas",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "roles": {
    "realm": [
      { "name": "platform-admin", "description": "Cross-tenant platform administrator" },
      { "name": "tenant-admin", "description": "Full access within their own tenant" },
      { "name": "tenant-member", "description": "Standard member access within their own tenant" }
    ]
  },
  "clients": [
    {
      "clientId": "multitenant-saas-api",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "redirectUris": ["http://localhost:5173/*"],
      "webOrigins": ["http://localhost:5173"],
      "protocolMappers": [
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "tenant_id",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "tenant_id",
            "jsonType.label": "String"
          }
        },
        {
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "multitenant-saas-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "alice",
      "email": "alice@acme.example",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Anderson",
      "credentials": [{ "type": "password", "value": "Passw0rd!", "temporary": false }],
      "realmRoles": ["tenant-admin"],
      "attributes": { "tenant_id": ["11111111-1111-1111-1111-111111111111"] }
    },
    {
      "username": "bob",
      "email": "bob@acme.example",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Brown",
      "credentials": [{ "type": "password", "value": "Passw0rd!", "temporary": false }],
      "realmRoles": ["tenant-member"],
      "attributes": { "tenant_id": ["11111111-1111-1111-1111-111111111111"] }
    },
    {
      "username": "carol",
      "email": "carol@globex.example",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Carol",
      "lastName": "Clark",
      "credentials": [{ "type": "password", "value": "Passw0rd!", "temporary": false }],
      "realmRoles": ["tenant-admin"],
      "attributes": { "tenant_id": ["22222222-2222-2222-2222-222222222222"] }
    },
    {
      "username": "root",
      "email": "root@platform.example",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Root",
      "lastName": "Admin",
      "credentials": [{ "type": "password", "value": "Passw0rd!", "temporary": false }],
      "realmRoles": ["platform-admin"]
    }
  ]
}
